 },
 "aggregateRating": {
 "@type": "AggregateRating",
 "ratingValue": "4.9",
 "bestRating": "5",
 "ratingCount": "53"
 },
 "review": [
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Yik Hei Wong"
 },
 "reviewBody": "非常感謝陳家富醫生。主要是因為失眠和想調理身體準備懷孕，所以轉向中醫。之前試過無數中醫都沒效果，但陳醫生的治療真的有效。",
 "datePublished": "2023"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Connie wong"
 },
 "reviewBody": "跟隨張醫生多年。無論是調理身體、備孕、懷孕還是產後，張醫生都全心全意治療，非常感激。診所的女孩們也非常用心，服務一流。",
 "datePublished": "2020"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Poon Poon"
 },
 "reviewBody": "我長期患濕疹並對西藥過敏。有一次嚴重發作，偶然發現這個地方。看了幾年中醫後，情況已穩定。",
 "datePublished": "2023"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "張天德"
 },
 "reviewBody": "去過醫天圓後，你就會意識到看中醫可以多麼舒適。環境很好，有書可讀，還有筆讓你畫畫。最重要的是，醫生一流，特別是我女兒的濕疹，很快就好了。",
 "datePublished": "2020"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Timmy Cheung"
 },
 "reviewBody": "長期腰痛。在醫天圓針灸後，背部疼痛大大緩解。現在久坐也不感到疼痛。",
 "datePublished": "2018"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Chris"
 },
 "reviewBody": "梁仲威醫生治好了我的背痛。環境安靜。診所的女孩們友善有禮。絕對值得推薦。",
 "datePublished": "2024"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Pingyung Li"
 },
 "reviewBody": "這次去醫園看周德健醫生，試圖解決腳冷的問題。網上預約非常方便。到診後，周醫生先把脈，非常仔細。",
 "datePublished": "2024"
 },
 {
 "@type": "Review",
 "reviewRating": {
 "@type": "Rating",
 "ratingValue": "5"
 },
 "author": {
 "@type": "Person",
 "name": "Agnes Kai"
 },
 "reviewBody": "陳醫生對病人非常有耐心和體貼。經過陳醫生幾個月的治療，我的肺和胃都有顯著改善，痰也大大改善了。",
 "datePublished": "2020"
 }
