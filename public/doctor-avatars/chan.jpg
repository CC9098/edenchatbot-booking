.pink {
 color: #f85998;}
#main-logo .navbar-brand img {
 width: auto;
 height: 100%;
 display: block;
 margin: auto;
}
.zi_box_1 {
position: relative;
margin: 2em 0;
padding: 1em;
background-color:#fefdfa; 
border: solid 2px #3A6813; /*框線*/
border-radius: 8px;
}
.zi_box_1 .zi_box_2 {
position: absolute;
display: inline-block;
top: -27px;
left: -3px;
padding: 0 9px;
height: 25px;
line-height: 25px;
font-size: 17px;
background:#3A6813;/*標題底色*/
color: #FFFFFF;
font-weight: bold;
border-radius:8px 8px 0 0;
}
.zi_box_3 {
border: 5px solid #74a17d;/* 框線顏色 */
margin: 2em 0;
padding: 20px;
position: relative;
}
.zi_box_3::before {
background-color: #fff;
color: #6c8457;
content: "注意!";/*標題*/
font-weight: bold;
left: 1em;
padding: 0 .5em;
position: absolute;
top: -1em;
}
mark_1 {
background: linear-gradient(#fff 75%, #fff799 0%) !important;
font-weight:bold; 
}
.zi_box_4 {
border: 2px solid #6b966b;/* 框線顏色 */
margin: 1em 0;
padding: 10px;
position: relative;
border-radius:8px 8px 8px 8px;
