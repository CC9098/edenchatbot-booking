 const wrapper = document.getElementById('eden-chatbot-wrapper');
 if (!wrapper) return;
 wrapper.innerHTML = ` <iframe
 id="eden-chatbot-iframe"
 src="https://edenchatbot-production.up.railway.app/embed?v=6"
 allow="clipboard-write"
 ></iframe> `;
 window.addEventListener('message', (e) => {
 if (e.data?.type !== 'chatbot-state') return;
 const iframe = wrapper.querySelector('iframe');
 if (!iframe) return;
 if (e.data.open) {
 wrapper.classList.add('open');
 wrapper.style.pointerEvents = 'auto';
 iframe.style.pointerEvents = 'auto';
 } else {
 wrapper.classList.remove('open');
 wrapper.style.pointerEvents = 'auto';
 iframe.style.pointerEvents = 'auto';
 }
 });
 })(); </script> <script type="application/ld+json" id="slim-seo-schema">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://www.edenclinic.hk/#website","url":"https://www.edenclinic.hk/","name":"醫天圓中醫診所","inLanguage":"zh-TW","potentialAction":{"@id":"https://www.edenclinic.hk/#searchaction"},"publisher":{"@id":"https://www.edenclinic.hk/#organization"}},{"@type":"SearchAction","@id":"https://www.edenclinic.hk/#searchaction","target":"https://www.edenclinic.hk/?s={search_term_string}","query-input":"required name=search_term_string"},{"@type":"BreadcrumbList","name":"導覽標記","@id":"https://www.edenclinic.hk/wp-content/uploads/2021/05/%E9%86%AB%E5%A4%A9%E5%9C%93%E4%B8%AD%E9%86%AB-%E9%99%B3%E5%AE%B6%E5%AF%8C%E4%B8%AD%E9%86%AB%E5%B8%AB%EF%BC%8C%E4%B8%AD%E9%86%AB%E5%85%A8%E7%A7%91%EF%BC%8C%E9%AA%A8%E5%82%B7%E7%A7%91%EF%BC%8C%E5%85%92%E7%A7%91%EF%BC%8C%E4%B8%AD%E9%86%AB%E9%86%AB%E9%95%B7%E8%80%85%E6%8E%A8%E4%BB%8B%EF%BC%8C%E4%BD%90%E6%95%A6%E4%B8%AD%E9%86%AB%E5%B8%AB%E6%8E%A8%E4%BB%8B%EF%BC%8C%E8%8D%83%E7%81%A3%E4%B8%AD%E9%86%AB%E5%B8%AB%E6%8E%A8%E4%BB%8B%EF%BC%8C%E4%B8%AD%E9%86%AB%E5%AE%B6%E5%BA%AD%E9%86%AB%E7%94%9F.jpg#breadcrumblist","itemListElement":[{"@type":"ListItem","position":1,"name":"首頁","item":"https://www.edenclinic.hk/"},{"@type":"ListItem","position":2,"name":"找不到符合條件的頁面"}]},{"@type":"WebPage","@id":"https://www.edenclinic.hk/wp-content/uploads/2021/05/%E9%86%AB%E5%A4%A9%E5%9C%93%E4%B8%AD%E9%86%AB-%E9%99%B3%E5%AE%B6%E5%AF%8C%E4%B8%AD%E9%86%AB%E5%B8%AB%EF%BC%8C%E4%B8%AD%E9%86%AB%E5%85%A8%E7%A7%91%EF%BC%8C%E9%AA%A8%E5%82%B7%E7%A7%91%EF%BC%8C%E5%85%92%E7%A7%91%EF%BC%8C%E4%B8%AD%E9%86%AB%E9%86%AB%E9%95%B7%E8%80%85%E6%8E%A8%E4%BB%8B%EF%BC%8C%E4%BD%90%E6%95%A6%E4%B8%AD%E9%86%AB%E5%B8%AB%E6%8E%A8%E4%BB%8B%EF%BC%8C%E8%8D%83%E7%81%A3%E4%B8%AD%E9%86%AB%E5%B8%AB%E6%8E%A8%E4%BB%8B%EF%BC%8C%E4%B8%AD%E9%86%AB%E5%AE%B6%E5%BA%AD%E9%86%AB%E7%94%9F.jpg#webpage","url":"https://www.edenclinic.hk/wp-content/uploads/2021/05/%E9%86%AB%E5%A4%A9%E5%9C%93%E4