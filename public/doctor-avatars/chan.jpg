 const mask = document.getElementById('eden-chatbot-mask');
 const customBtn = document.getElementById('eden-custom-btn');
 if(!mask) return;
 function createChatbot() {
 mask.innerHTML = '<iframe id="eden-chatbot-iframe" src="https://edenchatbot-production.up.railway.app/embed?v=6" allow="microphone; clipboard-write" allowtransparency="true"></iframe>';
 }
 createChatbot();
 setTimeout(createChatbot, 1500);
 window.addEventListener('message', function(t){
 if(t.data?.type === 'chatbot-state'){
 const iframe = document.getElementById('eden-chatbot-iframe');
 if(iframe) {
 if(t.data.open) {
 mask.classList.add('open');
 customBtn.style.display = 'none';
 } else {
 mask.classList.remove('open');
 customBtn.style.display = 'flex';
 }
 }
 }
 });
}(); </script> <style> /* =========================================
 鑽石級玻璃按鈕
 ========================================= */
 #eden-custom-btn {
 position: fixed;
 z-index: 2147483646;
 width: 50px; 
 height: 145px; 
 /* 位置下調：從 180 改為 150 */
 bottom: 150px;
 right: 0; 
 /* 鑽石級玻璃材質 */
 background: linear-gradient(
 125deg,
 rgba(255, 255, 255, 0.8) 0%,
 rgba(255, 255, 255, 0.4) 100%
 ); 
 /* 超強模糊 */
 backdrop-filter: blur(40px) saturate(200%);
 -webkit-backdrop-filter: blur(40px) saturate(200%); 
 /* 鑽石邊框：左側與上下有亮邊，右側貼邊 */
 border-top: 1.5px solid rgba(255, 255, 255, 0.95);
 border-bottom: 1.5px solid rgba(255, 255, 255, 0.5);
 border-left: 1.5px solid rgba(255, 255, 255, 0.8);
 border-right: none; 
 border-radius: 25px 0 0 25px; 
 /* 立體光影 */
 box-shadow: 
 -8px 8px 20px 0 rgba(31, 38, 135, 0.15), /* 深邃陰影 */
 inset 2px 2px 5px 0 rgba(255, 255, 255, 0.8), /* 頂部高光 */
 inset -2px -2px 5px 0 rgba(255, 255, 255, 0.2); /* 底部反光 */
 display: flex;
 flex-direction: column;
 justify-content: center;
 align-items: center;
 font-family: "PingFang HK", "Microsoft JhengHei", sans-serif;
 transition: all 0.3s ease;
 } 
 /* 點擊反饋 */
 #eden-custom-btn:active {
 transform: scale(0.98);
 box-shadow: -4px 4px 10px 0 rgba(31, 38, 135, 0.1);
 }
 .btn-text {
 font-size: 15px; /* 字體加大 */
 font-weight: 900; /* 極粗 */
 color: #1a5f3a;   /* 翡翠綠 */
 writing-mode: vertical-rl;
 text-orientation: upright;
 letter-spacing: 5px;
 margin-top: 15px;
 text-shadow: 0 1px 0 rgba(255,255,255,0.9); /* 刻字效果 */
 }
 .btn-icon {
 color: #27ae60;
 /* 螢光濾鏡 */
 filter: drop-shadow(0 0 5px rgba(39, 174, 96, 0.4)); 
 }
 /* =========================================
 遮罩與定位
 ========================================= */
 #eden-chatbot-mask {
 position: fixed;
 z-index: 2147483647;
 width: 60px;
 height: 160px; 
 /* 跟隨按鈕位置下調 */
 bottom: 140px; 
 right: 0; 
 overflow: hidden;
 pointer-events: auto;
 opacity: 0; 
 }
 #eden-chatbot-iframe {
 position: absolute;
 border: none;
 background: transparent;
 width: 300px;
 height: 400px; 
 /* 保持下沉定位 */
 bottom: -50px; 
 right: -20px;
 }
 #eden-chatbot-mask.open {
 width: 420px !important;
 height: 720px !important;
 bottom: 0 !important;
 right: 0 !important;
 opacity: 1 !important;
 overflow: visible !important;
 background: transparent !important;
 }
 #eden-chatbot-mask.open iframe {
 width: 100% !important;
 height: 100% !important;
 bottom: 0 !important;
 right: 0 !important;
 }
 @media (max-width: 768px) {
 #eden-chatbot-mask.open {
 width: 100vw !important;
 height: 100vh !important;
 bottom: 0 !important;
 right: 0 !important;
