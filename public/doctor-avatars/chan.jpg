 {
 "@type": [
 "MedicalOrganization",
 "LocalBusiness"
 ],
 "@id": "https://www.edenclinic.hk/#organization",
 "name": "醫天圓中醫診所",
 "alternateName": "Eden TCM Clinic",
 "url": "https://www.edenclinic.hk",
 "logo": {
 "@type": "ImageObject",
 "url": "https://www.edenclinic.hk/wp-content/uploads/2016/09/logo.png",
 "width": 800,
 "height": 200
 },
 "image": "https://www.edenclinic.hk/wp-content/uploads/2016/09/logo.png",
 "description": "醫天圓中醫診所創立於香港，擁有十三年深厚診療經驗。我們的專業團隊由六位註冊中醫師組成，均畢業於香港大學及香港中文大學中醫學院，並具備英國曼徹斯特都會大學營養學碩士學歷與腫瘤、婦科等專科高級文憑。診所累積逾十萬人次以上診症量經驗，在中環、佐敦、荃灣三個便利的地鐵站點為市民服務。我們特別重視現代醫學與傳統中醫理念的結合，深入聆聽病人需要，主張將生活養生與治療緊密連結，為病人提供全面的健康方案。秉持「專注、聆聽、連結、歸正」的服務理念。",
 "priceRange": "$$",
 "foundingDate": "2012",
 "numberOfEmployees": {
 "@type": "QuantitativeValue",
 "value": 6
 },
 "address": {
 "@type": "PostalAddress",
 "streetAddress": "皇后大道中70號卡佛大廈23樓2310室",
 "addressLocality": "中環",
